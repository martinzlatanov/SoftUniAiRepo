{
  "designSystem": {
    "name": "Vibe Coding Solar Panel Design System",
    "version": "1.0.0",
    "description": "A modern, minimalist design system with a solar energy theme. Dark-first, high-contrast, tech-forward aesthetic.",
    "designPrinciples": [
      "Minimalism: Every element serves a purpose. Remove unnecessary visual noise.",
      "High Contrast: Ensure readability and visual hierarchy through bold color choices.",
      "Clean Grid: Use a 8px base grid system for all spacing and sizing.",
      "Modern Simplicity: Embrace negative space and let content breathe.",
      "Solar Energy Inspiration: Use warm, energetic accents (gold/yellow) to convey tech and innovation.",
      "Dark-First: Default to dark backgrounds for reduced eye strain and premium feel.",
      "Consistency: Maintain visual harmony across all components and screens."
    ],
    "colorPalette": {
      "primary": {
        "dark": "#1a1a1e",
        "darkAlt": "#2a2a2e",
        "medium": "#3a3a3e",
        "light": "#4a4a4e"
      },
      "accent": {
        "solar": "#ffd700",
        "solarLight": "#ffed4e",
        "solarDark": "#d4af37",
        "energyOrange": "#ff9800",
        "vibrantYellow": "#ffc107"
      },
      "semantic": {
        "success": "#4caf50",
        "warning": "#ff9800",
        "error": "#f44336",
        "info": "#2196f3"
      },
      "neutral": {
        "white": "#ffffff",
        "gray100": "#f5f5f5",
        "gray200": "#e0e0e0",
        "gray300": "#d0d0d0",
        "gray400": "#9e9e9e",
        "gray500": "#757575",
        "gray600": "#616161",
        "gray700": "#424242",
        "gray800": "#212121",
        "black": "#000000"
      },
      "backgrounds": {
        "primary": "#1a1a1e",
        "secondary": "#2a2a2e",
        "tertiary": "#3a3a3e",
        "overlay": "rgba(0, 0, 0, 0.7)"
      },
      "text": {
        "primary": "#ffffff",
        "secondary": "#d0d0d0",
        "tertiary": "#a0a0a0",
        "disabled": "#616161"
      }
    },
    "typography": {
      "fontFamily": {
        "primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif",
        "mono": "'Courier New', 'Monaco', 'Menlo', monospace"
      },
      "fontWeights": {
        "light": 300,
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      },
      "scales": {
        "h1": {
          "fontSize": "2.5rem",
          "lineHeight": "1.2",
          "fontWeight": 700,
          "letterSpacing": "-0.02em",
          "usage": "Page titles, hero headlines"
        },
        "h2": {
          "fontSize": "2rem",
          "lineHeight": "1.3",
          "fontWeight": 700,
          "letterSpacing": "-0.01em",
          "usage": "Section headers"
        },
        "h3": {
          "fontSize": "1.5rem",
          "lineHeight": "1.4",
          "fontWeight": 600,
          "letterSpacing": "0em",
          "usage": "Subsection headers"
        },
        "h4": {
          "fontSize": "1.25rem",
          "lineHeight": "1.4",
          "fontWeight": 600,
          "letterSpacing": "0em",
          "usage": "Card titles, component headers"
        },
        "body": {
          "fontSize": "1rem",
          "lineHeight": "1.6",
          "fontWeight": 400,
          "letterSpacing": "0em",
          "usage": "Body text, paragraphs"
        },
        "bodySmall": {
          "fontSize": "0.875rem",
          "lineHeight": "1.5",
          "fontWeight": 400,
          "letterSpacing": "0em",
          "usage": "Secondary text, captions"
        },
        "caption": {
          "fontSize": "0.75rem",
          "lineHeight": "1.4",
          "fontWeight": 500,
          "letterSpacing": "0.02em",
          "usage": "Labels, helpers, meta info"
        },
        "code": {
          "fontSize": "0.875rem",
          "lineHeight": "1.5",
          "fontWeight": 400,
          "fontFamily": "mono",
          "usage": "Code blocks, inline code"
        }
      }
    },
    "spacing": {
      "baseUnit": "8px",
      "scale": {
        "xs": "4px",
        "sm": "8px",
        "md": "16px",
        "lg": "24px",
        "xl": "32px",
        "2xl": "48px",
        "3xl": "64px",
        "4xl": "96px"
      },
      "padding": {
        "compact": "12px",
        "standard": "16px",
        "generous": "24px",
        "section": "48px"
      },
      "margin": {
        "compact": "12px",
        "standard": "16px",
        "generous": "24px",
        "section": "48px"
      },
      "gap": {
        "tight": "4px",
        "compact": "8px",
        "standard": "16px",
        "generous": "24px",
        "large": "32px"
      }
    },
    "components": {
      "container": {
        "description": "Main content wrapper",
        "maxWidth": "1200px",
        "margin": "0 auto",
        "padding": "48px 24px",
        "backgroundColor": "#1a1a1e"
      },
      "card": {
        "description": "Elevated content container with subtle depth",
        "backgroundColor": "#2a2a2e",
        "padding": "24px",
        "borderRadius": "8px",
        "border": "1px solid rgba(255, 215, 0, 0.1)",
        "boxShadow": "0 4px 6px rgba(0, 0, 0, 0.3)",
        "transition": "all 0.3s ease",
        "hover": {
          "border": "1px solid rgba(255, 215, 0, 0.3)",
          "boxShadow": "0 8px 12px rgba(0, 0, 0, 0.4)",
          "transform": "translateY(-2px)"
        }
      },
      "button": {
        "primary": {
          "backgroundColor": "#ffd700",
          "color": "#1a1a1e",
          "padding": "12px 24px",
          "fontSize": "1rem",
          "fontWeight": 600,
          "borderRadius": "6px",
          "border": "none",
          "cursor": "pointer",
          "transition": "all 0.3s ease",
          "hover": {
            "backgroundColor": "#ffed4e",
            "transform": "scale(1.02)"
          },
          "active": {
            "backgroundColor": "#d4af37"
          }
        },
        "secondary": {
          "backgroundColor": "#3a3a3e",
          "color": "#ffffff",
          "padding": "12px 24px",
          "fontSize": "1rem",
          "fontWeight": 600,
          "borderRadius": "6px",
          "border": "1px solid #ffd700",
          "cursor": "pointer",
          "transition": "all 0.3s ease",
          "hover": {
            "backgroundColor": "#4a4a4e",
            "borderColor": "#ffed4e"
          }
        },
        "tertiary": {
          "backgroundColor": "transparent",
          "color": "#ffd700",
          "padding": "8px 16px",
          "fontSize": "0.9rem",
          "fontWeight": 500,
          "border": "none",
          "cursor": "pointer",
          "transition": "all 0.3s ease",
          "hover": {
            "color": "#ffed4e",
            "textDecoration": "underline"
          }
        }
      },
      "input": {
        "description": "Form input fields",
        "backgroundColor": "#3a3a3e",
        "color": "#ffffff",
        "padding": "12px 16px",
        "fontSize": "1rem",
        "border": "1px solid #4a4a4e",
        "borderRadius": "6px",
        "transition": "all 0.3s ease",
        "focus": {
          "borderColor": "#ffd700",
          "boxShadow": "0 0 0 3px rgba(255, 215, 0, 0.1)",
          "outline": "none"
        },
        "placeholder": {
          "color": "#a0a0a0"
        }
      },
      "header": {
        "description": "Top navigation bar",
        "backgroundColor": "#1a1a1e",
        "borderBottom": "1px solid rgba(255, 215, 0, 0.1)",
        "padding": "16px 24px",
        "position": "sticky",
        "top": 0,
        "zIndex": 100,
        "boxShadow": "0 2px 8px rgba(0, 0, 0, 0.3)"
      },
      "badge": {
        "description": "Small status indicator",
        "padding": "4px 12px",
        "fontSize": "0.75rem",
        "fontWeight": 600,
        "borderRadius": "20px",
        "display": "inline-block",
        "variants": {
          "solar": {
            "backgroundColor": "#ffd700",
            "color": "#1a1a1e"
          },
          "success": {
            "backgroundColor": "#4caf50",
            "color": "#ffffff"
          },
          "warning": {
            "backgroundColor": "#ff9800",
            "color": "#ffffff"
          },
          "error": {
            "backgroundColor": "#f44336",
            "color": "#ffffff"
          }
        }
      },
      "divider": {
        "description": "Visual separator",
        "height": "1px",
        "backgroundColor": "rgba(255, 215, 0, 0.1)",
        "margin": "24px 0"
      },
      "tooltip": {
        "description": "Information hint on hover",
        "backgroundColor": "#3a3a3e",
        "color": "#ffffff",
        "padding": "8px 12px",
        "fontSize": "0.875rem",
        "borderRadius": "4px",
        "border": "1px solid rgba(255, 215, 0, 0.2)",
        "boxShadow": "0 4px 12px rgba(0, 0, 0, 0.5)"
      },
      "modal": {
        "description": "Dialog overlay container",
        "backgroundColor": "rgba(0, 0, 0, 0.7)",
        "backdropFilter": "blur(4px)",
        "content": {
          "backgroundColor": "#2a2a2e",
          "padding": "32px",
          "borderRadius": "12px",
          "maxWidth": "500px",
          "boxShadow": "0 20px 25px rgba(0, 0, 0, 0.5)"
        }
      }
    },
    "effects": {
      "shadows": {
        "sm": "0 2px 4px rgba(0, 0, 0, 0.2)",
        "md": "0 4px 6px rgba(0, 0, 0, 0.3)",
        "lg": "0 8px 12px rgba(0, 0, 0, 0.4)",
        "xl": "0 12px 24px rgba(0, 0, 0, 0.5)",
        "2xl": "0 20px 25px rgba(0, 0, 0, 0.6)"
      },
      "transitions": {
        "fast": "0.15s ease",
        "standard": "0.3s ease",
        "slow": "0.5s ease"
      },
      "borderRadius": {
        "none": "0px",
        "xs": "2px",
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "full": "9999px"
      }
    },
    "layout": {
      "gridSystem": "12 columns",
      "baseUnit": "8px",
      "containerMaxWidth": "1200px",
      "breakpoints": {
        "mobile": "0px",
        "tablet": "768px",
        "desktop": "1024px",
        "wide": "1400px"
      },
      "gutterWidth": "16px",
      "responsiveStackingPoint": "768px"
    },
    "designGuidelines": {
      "hierarchy": {
        "rule": "Create visual hierarchy through size, color, weight, and spacing.",
        "primary": "Use #ffd700 (solar gold) for primary actions and highlights.",
        "secondary": "Use #d0d0d0 (light gray) for secondary text and elements.",
        "tertiary": "Use #a0a0a0 (medium gray) for tertiary information."
      },
      "interaction": {
        "rule": "All interactive elements should provide clear feedback.",
        "hover": "Lighten color, scale up slightly, or change border color.",
        "active": "Darken color, shift inward (press effect) or increase shadow.",
        "disabled": "Reduce opacity to 50% and remove pointer events."
      },
      "whitespace": {
        "rule": "Generous spacing creates breathing room and improves readability.",
        "minimum": "Use at least 16px between distinct sections.",
        "cards": "Use 24px internal padding; 16px gap between cards.",
        "typography": "Maintain 1.4-1.6 line-height for body text."
      },
      "contrast": {
        "rule": "Ensure WCAG AAA compliance for accessibility.",
        "textOnDark": "Use white (#ffffff) or light gray (#d0d0d0).",
        "textOnAccent": "Use dark backgrounds (#1a1a1e) for solar gold text.",
        "minimumContrast": "7:1 for critical information"
      },
      "imagery": {
        "rule": "Use clean, modern, minimal imagery.",
        "style": "Flat, geometric, or modern illustration style.",
        "colorOverlay": "Apply semi-transparent solar gold overlay on images for brand consistency.",
        "sizing": "Ensure images scale responsively and don't distract from content."
      }
    },
    "usage": {
      "aiReplication": "This design.json serves as a detailed blueprint for AI to replicate the design system. Use these specifications as the source of truth for all UI generation.",
      "colorCoding": "All color variables are HEX codes and CSS custom properties ready for implementation.",
      "typography": "Font sizes are in REMs; convert based on 16px base if needed.",
      "spacing": "All spacing uses multiples of 8px for consistency.",
      "implementation": "Apply these rules consistently across all pages, components, and states."
    }
  }
}
